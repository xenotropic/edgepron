# --- Python bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
.eggs/
*.whl

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Local machine configuration (never commit) ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- Secrets & credentials (never commit) ---
.env
*.pem
.git-credentials

# --- Developer / internal files (do not publish) ---
resources/
runtimelogs/

# --- Runtime & debug artifacts ---
*.log
*.hprof
heapdump/
